                                                        <TextBlock.ToolTip>
                                                            <MultiBinding Converter="{StaticResource ManagementTextConverter}" ConverterParameter="">
                                                                <Binding Path="PriorityDescription" />
                                                                <Binding Path="Language" RelativeSource="{RelativeSource Self}" />
