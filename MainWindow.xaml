                                                                                    <MultiBinding Converter="{StaticResource ManagementTextConverter}" ConverterParameter="Group">
                                                                                        <Binding Path="Name" />
                                                                                        <Binding Path="Language" RelativeSource="{RelativeSource Self}" />
                                                                                    </MultiBinding>
                                                                                </TextBlock.Text>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Expander.Header>
