                                                    <TextBlock FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{DynamicResource OperationsText}">
                                                        <Run Text="{DynamicResource ManagementAvailableText}" />
                                                        <Run Text="{Binding AvailableVersion, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
