                                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{DynamicResource OperationsText}">
                                                        <Run Text="{DynamicResource ManagementInstalledText}" />
                                                        <Run Text="{Binding InstalledVersion, Mode=OneWay}" />
