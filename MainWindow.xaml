                                                    <TextBlock Text="Superfici luminose" Style="{DynamicResource AppearanceDescription}" Margin="0,4,0,0" />
                                                    <Image Source="{StaticResource AppearanceLightPreview}" Style="{StaticResource AppearancePreview}" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>
                                        <Border Style="{StaticResource AppearanceChoiceCard}" Tag="{Binding IsChecked, ElementName=DarkThemeChoice}">
                                            <RadioButton x:Name="DarkThemeChoice" Tag="Scuro" GroupName="ThemeMode"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=DarkThemeLabel}"
                                                         Style="{DynamicResource AppearanceChoice}" Click="ThemeChoice_Click">
                                                <StackPanel>
                                                    <TextBlock x:Name="DarkThemeLabel" Text="Scuro" FontWeight="SemiBold" />
                                                    <TextBlock Text="Superfici scure" Style="{DynamicResource AppearanceDescription}" Margin="0,4,0,0" />
                                                    <Image Source="{StaticResource AppearanceDarkPreview}" Style="{StaticResource AppearancePreview}" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>
                                    </WrapPanel>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,20" />
                                    <TextBlock x:Name="AppearanceTextSizeLabel" Text="Dimensione del testo"
                                               FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold" />
                                    <TextBlock Text="Regola tutti i testi dell'applicazione per una lettura più comoda."
                                               Style="{DynamicResource AppearanceDescription}" Margin="0,5,0,16" />
                                    <WrapPanel KeyboardNavigation.TabNavigation="Once"
                                               AutomationProperties.LabeledBy="{Binding ElementName=AppearanceTextSizeLabel}">
                                        <Border Style="{StaticResource AppearanceTextChoiceCard}" Tag="{Binding IsChecked, ElementName=SmallFontChoice}">
                                            <RadioButton x:Name="SmallFontChoice" Tag="Piccola" GroupName="FontSizeMode"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=SmallFontLabel}"
                                                         Style="{DynamicResource AppearanceChoice}" Click="FontSizeChoice_Click">
                                                <TextBlock x:Name="SmallFontLabel" Text="Piccola" />
                                            </RadioButton>
                                        </Border>
                                        <Border Style="{StaticResource AppearanceTextChoiceCard}" Tag="{Binding IsChecked, ElementName=MediumFontChoice}">
                                            <RadioButton x:Name="MediumFontChoice" Tag="Media" GroupName="FontSizeMode"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=MediumFontLabel}"
                                                         Style="{DynamicResource AppearanceChoice}" Click="FontSizeChoice_Click">
                                                <TextBlock x:Name="MediumFontLabel" Text="Media" />
                                            </RadioButton>
                                        </Border>
                                        <Border Style="{StaticResource AppearanceTextChoiceCard}" Tag="{Binding IsChecked, ElementName=LargeFontChoice}">
                                            <RadioButton x:Name="LargeFontChoice" Tag="Grande" GroupName="FontSizeMode"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=LargeFontLabel}"
                                                         Style="{DynamicResource AppearanceChoice}" Click="FontSizeChoice_Click">
                                                <TextBlock x:Name="LargeFontLabel" Text="Grande" />
                                            </RadioButton>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="Le modifiche all'aspetto vengono salvate automaticamente."
                                               Style="{DynamicResource AppearanceDescription}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="StartupSettingsCard" Style="{DynamicResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="Avvio e scansioni automatiche" Style="{DynamicResource SettingsHeading}" />
                                    <CheckBox x:Name="StartupScanChoice" Click="OrdinaryPreference_Click" IsChecked="{Binding Settings.ScanAtStartup}"
                                              Style="{DynamicResource SettingsCheckBox}" AutomationProperties.LabeledBy="{Binding ElementName=StartupScanLabel}">
                                        <TextBlock x:Name="StartupScanLabel" Text="Avvia automaticamente la scansione all'apertura" />
                                    </CheckBox>
                                    <TextBlock x:Name="ScanFrequencyLabel" Text="Frequenza scansione" FontWeight="SemiBold" Margin="0,16,0,8" />
                                    <ComboBox x:Name="ScanFrequencyChoice" Style="{DynamicResource SettingsComboBox}"
                                              AutomationProperties.LabeledBy="{Binding ElementName=ScanFrequencyLabel}"
                                              SelectedValue="{Binding Settings.AutomaticScanInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="AutomaticScanInterval_SelectionChanged"
                                              SelectedValuePath="Tag" Width="248" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Disattivata" Tag="Off" />
                                        <ComboBoxItem Content="Ogni giorno" Tag="Daily" />
                                        <ComboBoxItem Content="Ogni settimana" Tag="Weekly" />
                                    </ComboBox>
                                    <TextBlock Text="La frequenza viene salvata automaticamente." Style="{DynamicResource AppearanceDescription}" Margin="0,6,0,0" />
                                    <TextBlock Text="La scansione periodica viene eseguita mentre Update Center è aperto oppure al successivo avvio, se è scaduta. L'installazione richiede sempre la tua conferma."
                                               Style="{DynamicResource AppearanceDescription}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="NotificationSettingsCard" Style="{DynamicResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="Notifiche" Style="{DynamicResource SettingsHeading}" />
                                    <CheckBox x:Name="NotificationChoice" Click="OrdinaryPreference_Click" IsChecked="{Binding Settings.NotifyWhenUpdatesAreAvailable}"
                                              Style="{DynamicResource SettingsCheckBox}" AutomationProperties.LabeledBy="{Binding ElementName=NotificationLabel}">
                                        <TextBlock x:Name="NotificationLabel" Text="Avvisami quando vengono trovati aggiornamenti" />
                                    </CheckBox>
                                    <TextBlock Text="Le notifiche sono locali e non richiedono account o servizi di telemetria."
                                               Style="{DynamicResource AppearanceDescription}" Margin="32,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="LanguageCard" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="24">
                                <Border.Resources>
                                    <ResourceDictionary Source="Styles/Appearance.xaml" />
                                </Border.Resources>
                                <StackPanel>
                                    <TextBlock x:Name="LanguageHeading" Text="Lingua" FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" />
                                    <TextBlock Text="Usa Update Center nella lingua che preferisci."
                                               Style="{DynamicResource AppearanceDescription}" Margin="0,6,0,24" />
                                    <WrapPanel KeyboardNavigation.TabNavigation="Once"
                                               AutomationProperties.LabeledBy="{Binding ElementName=LanguageHeading}">
                                        <Border Style="{DynamicResource AppearanceChoiceCard}" Tag="{Binding IsChecked, ElementName=ItalianLanguageChoice}">
                                            <RadioButton x:Name="ItalianLanguageChoice" Tag="it" GroupName="LanguageMode"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=ItalianLanguageLabel}"
                                                         Style="{DynamicResource AppearanceChoice}" Click="LanguageChoice_Click">
                                                <StackPanel>
                                                    <TextBlock x:Name="ItalianLanguageLabel" Text="Italiano" FontWeight="SemiBold" />
                                                    <TextBlock Text="IT" Style="{DynamicResource AppearanceDescription}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>
                                        <Border Style="{DynamicResource AppearanceChoiceCard}" Tag="{Binding IsChecked, ElementName=EnglishLanguageChoice}">
                                            <RadioButton x:Name="EnglishLanguageChoice" Tag="en" GroupName="LanguageMode"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=EnglishLanguageLabel}"
                                                         Style="{DynamicResource AppearanceChoice}" Click="LanguageChoice_Click">
                                                <StackPanel>
                                                    <TextBlock x:Name="EnglishLanguageLabel" Text="Inglese" FontWeight="SemiBold" />
                                                    <TextBlock Text="EN" Style="{DynamicResource AppearanceDescription}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="La lingua viene applicata e salvata subito, senza riavviare."
                                               Style="{DynamicResource AppearanceDescription}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ProjectSettingsCard" Style="{DynamicResource SettingsCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Informazioni sul progetto" Style="{DynamicResource SettingsHeading}" Margin="0" />
                                    <TextBlock Text="Update Center per Windows 10 e Windows 11"
                                               Style="{DynamicResource AppearanceDescription}" Margin="0,6,0,20" />
                                    <WrapPanel Grid.IsSharedSizeScope="True">
                                        <Border Style="{DynamicResource SettingsMetadata}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" SharedSizeGroup="MetadataLabel" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Versione installata" Style="{DynamicResource AppearanceDescription}" />
                                                <TextBlock x:Name="AboutVersionText" Grid.Row="1" FontSize="{DynamicResource FontSize18}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{DynamicResource SettingsMetadata}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" SharedSizeGroup="MetadataLabel" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Ideato e sviluppato da" Style="{DynamicResource AppearanceDescription}" />
                                                <TextBlock Grid.Row="1" Text="Illidan0S" FontSize="{DynamicResource FontSize18}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{DynamicResource SettingsMetadata}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" SharedSizeGroup="MetadataLabel" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Licenza" Style="{DynamicResource AppearanceDescription}" />
                                                <TextBlock Grid.Row="1" Text="MIT" FontSize="{DynamicResource FontSize18}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                            </Grid>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="Update Center non raccoglie dati personali e non include telemetria."
                                               Style="{DynamicResource AppearanceDescription}" Margin="0,4,0,0" />
                                    <TextBlock Text="Scansioni, impostazioni, cronologia e log restano memorizzati localmente sul computer."
                                               Style="{DynamicResource AppearanceDescription}" Margin="0,5,0,0" />
                                    <Button x:Name="ProjectGitHubButton" Content="Apri GitHub" Style="{DynamicResource SettingsButton}" HorizontalAlignment="Left"
                                            Margin="0,16,0,0" Tag="https://github.com/Illidan0S/UpdateCenter" Click="OpenVendorSupport_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
