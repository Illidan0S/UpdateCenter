<Window x:Class="UpdateCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Update Center" Icon="Assets/UpdateCenter.ico" Width="1240" Height="790" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResize" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize15}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder" CornerRadius="22" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TitleSidebarColumn" Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/UpdateCenter.ico" Width="28" Height="28" Stretch="Uniform" />
                    <TextBlock x:Name="AppNameText" Text="Update Center" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="{DynamicResource FontSize14}" />
                    <Border x:Name="VersionBadge" Margin="8,0,0,0" Padding="7,3" VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                            BorderThickness="1" CornerRadius="7">
                        <TextBlock x:Name="VersionText" Text="v1.1.0" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="{DynamicResource FontSize10}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="PageTitle" Text="Home" Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="24,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,7,10,7">
                    <Button Style="{StaticResource WindowButton}" Content="—" Click="Minimize_Click" />
                    <Button Style="{StaticResource WindowButton}" Content="□" Click="Maximize_Click" />
                    <Button Style="{StaticResource WindowButton}" Content="×" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="12,0,0,12" CornerRadius="18" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SidebarHeading" Text="CONTROLLO PC" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}"
                                   FontWeight="SemiBold" Margin="12,10,0,12" />
                        <StackPanel Grid.Row="1">
                            <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Content="⌂   Home" ToolTip="Home" Click="HomeNav_Click" />
                            <Button x:Name="UpdatesNav" Style="{StaticResource NavButton}" Content="↓   Aggiornamenti" ToolTip="Aggiornamenti" Click="UpdatesNav_Click" />
                            <Button x:Name="SystemInfoNav" Style="{StaticResource NavButton}" Content="▤   Hardware" ToolTip="Hardware" Click="SystemInfoNav_Click" />
                            <Button x:Name="HardwareNav" Style="{StaticResource NavButton}" Content="▣   Driver e chipset" ToolTip="Driver e chipset" Click="HardwareNav_Click" />
                            <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Content="◷   Cronologia" ToolTip="Cronologia" Click="HistoryNav_Click" />
                            <Button x:Name="NetworkNav" Style="{StaticResource NavButton}" Content="⌘   Gestione rete" ToolTip="Gestione rete" Click="NetworkNav_Click" />
                            <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="⚙   Impostazioni" ToolTip="Impostazioni" Click="SettingsNav_Click" />
                        </StackPanel>
                        <Border x:Name="SidebarSourceCard" Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14" Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Controllo locale" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" />
                                <TextBlock Text="Nessuna telemetria" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{DynamicResource FontSize11}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid x:Name="ContentHost" Grid.Column="1" Margin="18,0,18,18">
                    <!-- HOME -->
                    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="32" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="HomeStatusColumn" Width="300" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="HomeHeroContent">
                                        <TextBlock Text="Mantieni il PC aggiornato" FontSize="{DynamicResource FontSize30}" FontWeight="SemiBold" />
                                        <TextBlock Text="Controlla software e driver da fonti ufficiali, poi scegli tu cosa installare."
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize15}" Margin="0,10,20,24"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Avvia scansione" Style="{StaticResource RoundedButton}"
                                                    IsEnabled="{Binding CanScan}" Click="Scan_Click" />
                                            <Button Content="Annulla" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                                    IsEnabled="{Binding IsScanRunning}"
                                                    Click="CancelScan_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border x:Name="HomeStatusCard" Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="18" Padding="24">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="STATO" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" Margin="0,8,0,4"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Avanzamento" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,14,0,10" />
                                    <TextBlock Text="{Binding CurrentItemText}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource FontSize12}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Elementi trovati" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding ScannedCount}" FontSize="{DynamicResource FontSize30}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Aggiornamenti" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding AvailableCount}" FontSize="{DynamicResource FontSize30}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Selezionati" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding SelectedCount}" FontSize="{DynamicResource FontSize30}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ULTIMA SCANSIONE" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LastScanLabel}" FontSize="{DynamicResource FontSize18}" FontWeight="SemiBold" Margin="0,7,0,4" />
                                        <TextBlock Text="{Binding HomeScanSummary}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSize12}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Vedi aggiornamenti" Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Center" Margin="20,0,0,0" Click="OpenUpdates_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- AGGIORNAMENTI -->
                    <Grid x:Name="UpdatesPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="UpdateFilterColumn" Width="165" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,10,0">
                                <TextBox x:Name="UpdateSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Cerca per nome, produttore, versione, fonte o stato"
                                         Style="{StaticResource ModernSearchBox}" />
                                <TextBlock Text="Cerca aggiornamenti" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=UpdateSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ComboBox Grid.Column="1" SelectedValue="{Binding UpdateTypeFilter}" SelectedValuePath="Tag"
                                      Margin="0,0,10,0" ToolTip="Filtra gli aggiornamenti">
                                <ComboBoxItem Content="Tutti" Tag="Tutti" />
                                <ComboBoxItem Content="Software" Tag="Software" />
                                <ComboBoxItem Content="Driver" Tag="Driver" />
                                <ComboBoxItem Content="Runtime" Tag="Runtime" />
                                <ComboBoxItem Content="Errori" Tag="Errori" />
                            </ComboBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ShowProgressButton" Content="Mostra avanzamento" Style="{StaticResource RoundedButton}"
                                        Visibility="Collapsed" Margin="0,0,8,0" Click="ShowProgress_Click" />
                                <Button Content="Nuova scansione" Style="{StaticResource SecondaryButton}"
                                        IsEnabled="{Binding CanScan}" Click="Scan_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <DataGrid x:Name="UpdatesGrid" ItemsSource="{Binding UpdatesView}"
                                      IsReadOnly="False" SelectionUnit="FullRow" Margin="0">
                                <DataGrid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridText}" />
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="52">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <CheckBox Style="{StaticResource ModernCheckBox}"
                                                              IsEnabled="{Binding CanInstall}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Nome" Width="2.2*" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SourceSummary}" Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="{DynamicResource FontSize10}" Margin="0,3,0,0"
                                                               ToolTip="{Binding CompatibilityDetail}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Tipo" Binding="{Binding KindLabel}" Width="80" IsReadOnly="True"
                                                        ElementStyle="{StaticResource DataGridText}" />

                                    <DataGridTemplateColumn Header="Priorità" Width="125" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="PriorityBadge" CornerRadius="8" Padding="9,5" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}">
                                                    <Border.ToolTip>
                                                        <ToolTip Content="{Binding PriorityDescription}" Style="{StaticResource WrappedToolTip}" />
                                                    </Border.ToolTip>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="PriorityText" Text="{Binding PriorityLabel}" Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" />
                                                        <TextBlock Text="  • Riavvio" Foreground="{DynamicResource WarningBrush}" FontSize="{DynamicResource FontSize10}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridText}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RequiresRestart}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding PriorityLabel}" Value="Importante">
                                                        <Setter TargetName="PriorityBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        <Setter TargetName="PriorityText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PriorityLabel}" Value="Important">
                                                        <Setter TargetName="PriorityBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        <Setter TargetName="PriorityText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PriorityLabel}" Value="Facoltativo">
                                                        <Setter TargetName="PriorityBadge" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                        <Setter TargetName="PriorityText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PriorityLabel}" Value="Optional">
                                                        <Setter TargetName="PriorityBadge" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                        <Setter TargetName="PriorityText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Versione attuale" Width="155" MinWidth="135" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding InstalledVersion}" Style="{StaticResource DataGridText}"
                                                           ToolTip="{Binding InstalledVersion}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Nuova versione" Width="155" MinWidth="135" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AvailableVersion}" Style="{StaticResource DataGridText}"
                                                           ToolTip="{Binding AvailableVersion}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Dimensione" Binding="{Binding Size}" Width="115" IsReadOnly="True"
                                                        ElementStyle="{StaticResource DataGridText}" />

                                    <DataGridTemplateColumn Header="Stato" Width="1.2*" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel.ToolTip>
                                                        <ToolTip Content="{Binding ResultDetails}" Style="{StaticResource WrappedToolTip}" />
                                                    </StackPanel.ToolTip>
                                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ResultDetails}" Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="{DynamicResource FontSize9}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="Apri fonte" Padding="8,2" Height="28"
                                                            VerticalAlignment="Center" Margin="0,0,7,0"
                                                            FontSize="{DynamicResource FontSize10}"
                                                            Tag="{Binding OfficialReleasePageUrl}"
                                                            Click="OpenVendorSupport_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanOpenOfficialSource}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Riprova" Padding="9,6" FontSize="{DynamicResource FontSize10}"
                                                            Click="RetryUpdate_Click"
                                                            IsEnabled="{Binding DataContext.CanScan, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Grid x:Name="UpdatesFooter" Grid.Row="2" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="UpdatesFooterSecondRow" Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="Seleziona tutto" Style="{StaticResource SecondaryButton}" Click="SelectAll_Click" />
                                <Button Content="Deseleziona tutto" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="DeselectAll_Click" />
                            </StackPanel>
                            <TextBlock x:Name="VisibleUpdatesText" Grid.Column="1"
                                       Text="{Binding VisibleUpdateCount, StringFormat={}{0} risultati visibili}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="12,0" />
                            <StackPanel x:Name="UpdatesFooterRight" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} selezionati}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,14,0" />
                                <Button Content="Aggiorna elementi selezionati" Style="{StaticResource RoundedButton}"
                                        IsEnabled="{Binding CanUpdate}" Click="InstallSelected_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- PANORAMICA HARDWARE -->
                    <ScrollViewer x:Name="SystemInfoPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Caratteristiche hardware" FontSize="{DynamicResource FontSize27}" FontWeight="SemiBold" />
                                        <TextBlock Text="Informazioni selezionabili e utilizzo aggiornato automaticamente."
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0" />
                                        <TextBlock Text="{Binding HardwareInfo.MonitoringStatus}" Foreground="{DynamicResource SuccessBrush}"
                                                   FontSize="{DynamicResource FontSize11}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Apri Gestione attività" Style="{StaticResource RoundedButton}"
                                            VerticalAlignment="Center" Margin="20,0,0,0" Click="OpenTaskManager_Click" />
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="CPU" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" />
                                            <TextBox Text="{Binding HardwareInfo.CpuName, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     FontSize="{DynamicResource FontSize18}" FontWeight="SemiBold" Margin="0,8,0,14" />
                                            <TextBlock Text="CORE E THREAD" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" />
                                            <TextBox Text="{Binding HardwareInfo.CpuCores, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     Margin="0,5,0,14" />
                                            <Grid>
                                                <TextBlock Text="Utilizzo" Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding HardwareInfo.CpuUsageLabel}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            </Grid>
                                            <ProgressBar Value="{Binding HardwareInfo.CpuUsage, Mode=OneWay}" Maximum="100" Margin="0,8,0,14" />
                                            <StackPanel Margin="0,0,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HardwareInfo.HasCpuTemperature}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="TEMPERATURA CPU (CORE)" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" />
                                                <TextBox Text="{Binding HardwareInfo.CpuTemperature, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                         FontWeight="SemiBold" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="MEMORIA RAM" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" />
                                            <TextBox Text="{Binding HardwareInfo.RamTotal, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     FontSize="{DynamicResource FontSize18}" FontWeight="SemiBold" Margin="0,8,0,12" />
                                            <Grid>
                                                <TextBlock Text="Utilizzo" Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding HardwareInfo.RamUsageLabel}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            </Grid>
                                            <ProgressBar Value="{Binding HardwareInfo.RamUsage, Mode=OneWay}" Maximum="100" Margin="0,8,0,10" />
                                            <TextBox Text="{Binding HardwareInfo.RamUsed, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="SISTEMA OPERATIVO" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" />
                                            <TextBox Text="{Binding HardwareInfo.OperatingSystem, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold" Margin="0,8,0,12" />
                                            <TextBlock Text="COMPUTER" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" />
                                            <TextBox Text="{Binding HardwareInfo.ComputerModel, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="SCHEDE VIDEO RILEVATE" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" />
                                            <TextBox Text="{Binding HardwareInfo.GpuName, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     TextWrapping="Wrap" FontSize="{DynamicResource FontSize18}" FontWeight="SemiBold" Margin="0,8,0,4" />
                                            <TextBox Text="{Binding HardwareInfo.GpuConfiguration, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                                     FontSize="{DynamicResource FontSize11}" Margin="0,0,0,14" />
                                            <TextBlock Text="MEMORIA VIDEO" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" />
                                            <TextBox Text="{Binding HardwareInfo.VramTotal, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold" Margin="0,5,0,10" />
                                            <TextBlock Text="DETTAGLIO MEMORIA PER GPU" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" />
                                            <TextBox Text="{Binding HardwareInfo.VramDetails, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     TextWrapping="Wrap" Margin="0,5,0,10" />
                                            <TextBlock Text="{Binding HardwareInfo.GpuMemoryUsageHeading, Mode=OneWay}"
                                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" />
                                            <TextBox Text="{Binding HardwareInfo.VramUsed, Mode=OneWay}"
                                                     Style="{StaticResource SelectableValue}" Foreground="{DynamicResource MutedTextBrush}"
                                                     FontSize="{DynamicResource FontSize11}" Margin="0,4,0,4" />
                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}"
                                                       TextWrapping="Wrap" Margin="0,0,0,14">
                                                <Run Text="Origine monitoraggio:" /><Run Text=" " /><Run Text="{Binding HardwareInfo.GpuMetricsSource, Mode=OneWay}" />
                                            </TextBlock>
                                            <Grid>
                                                <TextBlock Text="Utilizzo" Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding HardwareInfo.GpuUsageLabel}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            </Grid>
                                            <ProgressBar Value="{Binding HardwareInfo.GpuUsage, Mode=OneWay}" Maximum="100" Margin="0,8,0,14" />
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HardwareInfo.HasGpuTemperature}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="TEMPERATURA GPU" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" />
                                                <TextBox Text="{Binding HardwareInfo.GpuTemperature, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                         FontWeight="SemiBold" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="SCHERMO" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" />
                                            <TextBlock Text="RISOLUZIONE" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" Margin="0,12,0,0" />
                                            <TextBox Text="{Binding HardwareInfo.Resolution, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     FontSize="{DynamicResource FontSize18}" FontWeight="SemiBold" Margin="0,5,0,12" />
                                            <TextBlock Text="FREQUENZA" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" />
                                            <TextBox Text="{Binding HardwareInfo.RefreshRate, Mode=OneWay}" Style="{StaticResource SelectableValue}"
                                                     FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Grid>

                            <Border x:Name="StorageHealthCard" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0"
                                    ClipToBounds="True" PreviewMouseWheel="StorageHealthCard_PreviewMouseWheel">
                                <StackPanel>
                                    <Grid Margin="18,15,18,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Salute dello storage" FontWeight="SemiBold" FontSize="{DynamicResource FontSize16}" />
                                            <TextBlock Text="{Binding StorageHealthStatus}" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSize11}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold" Margin="16,0,0,0">
                                            <Run Text="{Binding StorageDeviceCount, Mode=OneWay}" /><Run Text=" unità fisiche · " />
                                            <Run Text="{Binding StorageVolumeCount, Mode=OneWay}" /><Run Text=" volumi" />
                                        </TextBlock>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding StorageRows}" IsReadOnly="True" SelectionUnit="FullRow"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0"
                                              VerticalContentAlignment="Center">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Unità" Width="1.45*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}">
                                                                <Run Text="{Binding KindLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Volumi" Width="1.35*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                            <TextBlock Text="{Binding VolumesLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding VolumesDetail}" Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="{DynamicResource FontSize9}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Capacità" Width="0.7*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding CapacityLabel}" VerticalAlignment="Center" Margin="8,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Salute" Width="1.35*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                            <TextBlock x:Name="StorageHealthText" Text="{Binding HealthLabel}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SuccessBrush}" />
                                                            <TextBlock Text="{Binding HealthDetail}" Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="{DynamicResource FontSize9}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsHealthUnknown}" Value="True">
                                                                <Setter TargetName="StorageHealthText" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsHealthy}" Value="False" />
                                                                    <Condition Binding="{Binding IsHealthUnknown}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="StorageHealthText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </MultiDataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Temperatura" Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TemperatureLabel}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Riepilogo completo" FontWeight="SemiBold" FontSize="{DynamicResource FontSize16}" />
                                        <TextBlock Text="Copia CPU, GPU, VRAM, RAM, Windows, versioni dei driver CPU/GPU e unità interne, escludendo i dispositivi USB."
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Copia informazioni hardware" Style="{StaticResource RoundedButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0"
                                            Click="CopyHardwareInfo_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- DRIVER E CHIPSET -->
                    <ScrollViewer x:Name="HardwarePage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                        <Border x:Name="DriverHeaderCard" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Driver e chipset" FontSize="{DynamicResource FontSize25}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CpuName}" FontSize="{DynamicResource FontSize15}" Margin="0,8,0,0" />
                                    <TextBlock x:Name="DriverMachineName" Text="{Binding ComputerName}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource FontSize12}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding HardwareCheckStatus}" Foreground="{DynamicResource SuccessBrush}"
                                               FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" Margin="0,7,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DriverSourceDescription" Text="Update Center usa Windows/Microsoft Update e metadati verificati con collegamenti diretti ai produttori. Se una fonte ufficiale non è interrogabile in modo sicuro, viene indicato un controllo manuale senza installare altre app."
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}"
                                               Margin="0,5,30,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="DriverSummaryPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="DRIVER DA CONTROLLARE" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSize10}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding DriverUpdateCount}" Foreground="{DynamicResource DangerBrush}"
                                                   FontSize="{DynamicResource FontSize30}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="20,0" />
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="CONTROLLI MANUALI" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSize10}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding VendorCheckCount}" Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="{DynamicResource FontSize30}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10" ClipToBounds="True">
                            <StackPanel>
                                <Grid Margin="18,15,18,10">
                                    <StackPanel>
                                        <TextBlock Text="Diagnosi driver problematici" FontWeight="SemiBold" FontSize="{DynamicResource FontSize15}" />
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" Margin="0,4,0,0">
                                            <Run Text="{Binding DriverProblemCount, Mode=OneWay}" /><Run Text=" problemi attivi segnalati da Gestione dispositivi" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <DataGrid ItemsSource="{Binding DriverProblems}" IsReadOnly="True" SelectionUnit="FullRow"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Dispositivo" Width="1.7*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding DeviceDetail}" Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="{DynamicResource FontSize10}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Problema" Width="1.35*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock x:Name="ProblemTitleText" Text="{Binding ErrorTitle}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource WarningBrush}" />
                                                        <TextBlock Text="{Binding ErrorCodeLabel}" Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="{DynamicResource FontSize9}" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critico">
                                                            <Setter TargetName="ProblemTitleText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Riparazione" Width="205">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Button Content="{Binding RepairActionText}" Style="{StaticResource SecondaryButton}"
                                                                Padding="10,6" HorizontalAlignment="Left"
                                                                IsEnabled="{Binding CanManageDriverProblem}"
                                                                Tag="{Binding}" Click="RepairDriver_Click" />
                                                        <TextBlock Text="{Binding RepairAvailabilityText}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="{DynamicResource FontSize9}" Margin="0,4,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding RepairAvailabilityText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Azione consigliata" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SuggestedAction}" TextWrapping="Wrap" ToolTip="{Binding DeviceId}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="La riparazione usa soltanto il pacchetto INF già registrato da Windows e richiede conferma amministratore. Nessun driver viene eliminato forzatamente."
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}"
                                           Margin="18,10,18,15" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" MinHeight="42" Margin="16,0,14,0">
                                    <TextBlock Text="Controlli manuali e supporto ufficiale" FontWeight="SemiBold"
                                               FontSize="{DynamicResource FontSize13}" VerticalAlignment="Center" />
                                    <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center">
                                        <Run Text="{Binding VendorCheckCount, Mode=OneWay}" /><Run Text=" disponibili" />
                                    </TextBlock>
                                </StackPanel>
                                <ScrollViewer x:Name="DriverVendorScrollViewer" Grid.Row="1" Height="142" Margin="12,0,12,12"
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="True" PreviewMouseWheel="DriverVendorScrollViewer_PreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding VendorTools}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="290" Height="134" Background="{DynamicResource SurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="13" Margin="0,0,9,0" Padding="13">
                                                    <Grid ToolTip="{Binding CompatibilityLabel}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   FontSize="{DynamicResource FontSize13}" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,4">
                                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="6,2" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding ConfidenceLabel}" Foreground="{DynamicResource AccentBrush}"
                                                                           FontSize="{DynamicResource FontSize9}" FontWeight="SemiBold" />
                                                            </Border>
                                                            <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="{DynamicResource FontSize9}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="{DynamicResource FontSize9}" TextWrapping="Wrap"
                                                                   MaxHeight="30" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Row="3" Content="{Binding ActionLabel}" Tag="{Binding LaunchTarget}"
                                                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                                                Padding="10,5" FontSize="{DynamicResource FontSize10}" Click="OpenVendorSupport_Click" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Margin="0,0,0,2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Background="{DynamicResource SurfaceAltBrush}" MinHeight="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="16,8">
                                        <TextBlock Text="Inventario driver installati" FontWeight="SemiBold" FontSize="{DynamicResource FontSize14}" />
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" Margin="0,3,0,0">
                                            <Run Text="{Binding DriverCount, Mode=OneWay}" /><Run Text=" dispositivi · " />
                                            <Run Text="{Binding ChipsetCount, Mode=OneWay}" /><Run Text=" CPU/chipset" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding VisibleDriverCount, StringFormat={}{0} visibili}"
                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,8" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="DriverFilterColumn" Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,10,0">
                                        <TextBox x:Name="DriverInventorySearchBox"
                                                 Text="{Binding DriverSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Cerca per dispositivo, categoria, produttore, versione o ID hardware"
                                                 Style="{StaticResource ModernSearchBox}" />
                                        <TextBlock Text="Cerca nei dispositivi" Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=DriverInventorySearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding DriverInventoryFilter}"
                                              SelectedValuePath="Tag">
                                        <ComboBoxItem Content="Tutti" Tag="Tutti" />
                                        <ComboBoxItem Content="Con aggiornamenti" Tag="Con aggiornamenti" />
                                        <ComboBoxItem Content="CPU e chipset" Tag="CPU e chipset" />
                                        <ComboBoxItem Content="Grafica" Tag="Grafica" />
                                        <ComboBoxItem Content="Audio" Tag="Audio" />
                                        <ComboBoxItem Content="Rete" Tag="Rete" />
                                    </ComboBox>
                                </Grid>

                                <DataGrid x:Name="DriverInventoryGrid" Grid.Row="2"
                                          ItemsSource="{Binding DriverInventoryView, Mode=OneWay}" IsReadOnly="True"
                                          SelectionUnit="FullRow" VerticalContentAlignment="Center"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="DriverInventoryGrid_PreviewMouseWheel">
                                    <DataGrid.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridText}" />
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Dispositivo" Width="2.4*">
                                            <DataGridTemplateColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="Padding" Value="16,10,10,10" />
                                                </Style>
                                            </DataGridTemplateColumn.HeaderStyle>
                                            <DataGridTemplateColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                    <Setter Property="Padding" Value="16,6,10,6" />
                                                </Style>
                                            </DataGridTemplateColumn.CellStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" ToolTip="{Binding DeviceName}" />
                                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="{DynamicResource FontSize10}" Margin="0,3,0,0">
                                                            <Run Text="{Binding CategoryLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ProviderLabel, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Versione installata" Width="1.15*" MinWidth="155">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding InstalledVersion}" FontWeight="SemiBold"
                                                                   ToolTip="{Binding InstalledVersion}" />
                                                        <TextBlock Text="{Binding DriverDateLabel, StringFormat=Data: {0}}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="{DynamicResource FontSize10}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Stato fonti ufficiali" Width="1.55*" MinWidth="230">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Border x:Name="DriverStatusBadge" Background="{DynamicResource AccentSoftBrush}"
                                                                CornerRadius="8" Padding="9,4" HorizontalAlignment="Left">
                                                            <TextBlock x:Name="DriverStatusText" Text="{Binding Status}"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="{DynamicResource FontSize9}" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetail}" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                            <Setter TargetName="DriverStatusBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                            <Setter TargetName="DriverStatusText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="" Width="112">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Vedi update" Height="28" VerticalAlignment="Center"
                                                            Padding="9,2" FontSize="{DynamicResource FontSize10}"
                                                            Click="OpenUpdates_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- GESTIONE RETE -->
                    <Grid x:Name="NetworkPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="NetworkDevicesRow" Height="300" MinHeight="190" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="NetworkPageHeaderGrid" Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="NetworkPageHeaderActionsRow" Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="NetworkPageHeaderTitle">
                                <TextBlock Text="Gestione rete" FontSize="{DynamicResource FontSize24}" FontWeight="SemiBold" />
                                <TextBlock Text="Trova e controlla i PC autorizzati nella rete locale"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel x:Name="NetworkPageHeaderActions" Grid.Column="1" VerticalAlignment="Center"
                                       HorizontalAlignment="Right">
                                <Border x:Name="NetworkPreviewBadge" Padding="12,7" CornerRadius="10"
                                        Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="Scansione multipla · aggiornamenti remoti"
                                               Foreground="{DynamicResource AccentBrush}" FontSize="{DynamicResource FontSize10}"
                                               FontWeight="SemiBold" />
                                </Border>
                                <Border Padding="12,6" Margin="8,0,0,0" CornerRadius="10"
                                        BorderThickness="1" MaxWidth="300">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Network.HasLocalController}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Network.LocalConnectionStateText}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Network.HasLocalController}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Network.LocalConnectionDetailText}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSize9}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Button Content="Configura questo PC" Style="{StaticResource SecondaryButton}"
                                        Padding="13,8" Margin="8,0,0,0" Click="ConfigureThisPc_Click" />
                            </WrapPanel>
                        </Grid>

                        <Grid x:Name="NetworkTopCardsGrid" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="NetworkTopCardsRowGap" Height="0" />
                                <RowDefinition x:Name="NetworkTopCardsSecondRow" Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="NetworkDevicesColumn" Width="*" />
                                <ColumnDefinition x:Name="NetworkTopCardsColumnGap" Width="0" />
                                <ColumnDefinition x:Name="NetworkPairingColumn" Width="0" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="NetworkDevicesCard" Grid.Column="0" Grid.ColumnSpan="3"
                                    Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid x:Name="NetworkDevicesHeaderGrid" Margin="18,14,18,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition x:Name="NetworkDeviceHeaderActionsRow" Height="0" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Dispositivi rilevati" FontSize="{DynamicResource FontSize16}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Seleziona uno o più PC da controllare"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSize10}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <WrapPanel x:Name="NetworkDeviceHeaderActions" Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="Cerca PC" Style="{StaticResource SecondaryButton}"
                                                    Padding="13,7" IsEnabled="{Binding Network.CanDiscover}"
                                                    Click="NetworkDiscover_Click" />
                                            <Button Content="{Binding Network.ConnectionRequestActionText}"
                                                    Style="{StaticResource SecondaryButton}" Padding="13,7" Margin="8,0,0,0"
                                                    IsEnabled="{Binding Network.CanRequestConnections}"
                                                    Click="NetworkRequestConnections_Click" />
                                            <Button Content="Controlla stato" Style="{StaticResource SecondaryButton}"
                                                    Padding="13,7" Margin="8,0,0,0"
                                                    IsEnabled="{Binding Network.CanContact}" Click="NetworkStatus_Click" />
                                            <Button Content="{Binding Network.ScanActionText}" Style="{StaticResource RoundedButton}"
                                                    Padding="13,7" Margin="8,0,0,0"
                                                    IsEnabled="{Binding Network.CanScanTargets}"
                                                    Click="NetworkScanSelected_Click" />
                                        </WrapPanel>
                                    </Grid>
                                    <DataGrid x:Name="NetworkDevicesGrid" Grid.Row="1" ItemsSource="{Binding Network.Agents}"
                                              SelectedItem="{Binding Network.SelectedAgent, Mode=TwoWay}"
                                              IsReadOnly="False" HeadersVisibility="Column" SelectionUnit="FullRow"
                                              AutoGenerateColumns="False" BorderThickness="0" Margin="0" RowHeight="62"
                                              CanUserResizeColumns="False" CanUserReorderColumns="False"
                                              CanUserSortColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Resources>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridText}" />
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="42">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource ModernCheckBox}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Dispositivo" Width="1.35*" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Endpoint}" Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="{DynamicResource FontSize10}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Autorizzazione" Width="1.1*" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AssociationText}" FontSize="{DynamicResource FontSize10}"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="●" FontSize="8" Margin="0,0,5,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ConnectionState}" Value="Raggiungibile">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ConnectionState}" Value="Operazione attiva">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ConnectionState}" Value="Non raggiungibile">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding ConnectionState}" Foreground="{DynamicResource MutedTextBrush}"
                                                                           FontSize="{DynamicResource FontSize10}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Attività" Width="1.3*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding OperationStatus}" FontSize="{DynamicResource FontSize10}"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <ProgressBar Grid.Row="1" Height="4" Margin="0,5,0,0"
                                                                         Minimum="0" Maximum="100" Value="{Binding Progress}">
                                                                <ProgressBar.Style>
                                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOperationActive}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="" Width="92">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding ConnectionActionText}" Padding="11,6" HorizontalAlignment="Center"
                                                                IsEnabled="{Binding CanStartConnectionAction}"
                                                                Tag="{Binding}" Click="NetworkSelectForPair_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPaired}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasController}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="2" Margin="18,9,18,12"
                                               Text="Spunta i PC da gestire. Usa Richiedi per il collegamento rapido oppure Codice come metodo alternativo."
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource FontSize10}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border x:Name="NetworkPairingCard" Grid.Column="2" Style="{StaticResource Card}"
                                    Padding="20" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Network.AssociationPanelTitle}"
                                                   FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Network.AssociationPanelDescription}"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}"
                                                   Margin="0,5,0,10" TextWrapping="Wrap" />
                                        <StackPanel x:Name="NetworkPairingControls">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Network.SelectedAgent.IsPaired}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <WrapPanel>
                                                <StackPanel Width="120" Margin="0,0,8,8">
                                                    <TextBlock Text="Codice (8 cifre)" Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="{DynamicResource FontSize10}" Margin="2,0,0,4" />
                                                    <TextBox Text="{Binding Network.PairingCode, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="8" />
                                                </StackPanel>
                                                <Button Content="Associa" Style="{StaticResource RoundedButton}" Margin="0,18,0,8"
                                                        VerticalAlignment="Top" IsEnabled="{Binding Network.CanPair}"
                                                        Click="NetworkPair_Click" />
                                            </WrapPanel>
                                            <Expander x:Name="NetworkAdvancedOptions" Header="Opzioni avanzate · indirizzo manuale"
                                                      Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}">
                                                <WrapPanel Margin="0,9,0,0">
                                                    <StackPanel Width="180" Margin="0,0,8,8">
                                                        <TextBlock Text="Indirizzo IP" Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="{DynamicResource FontSize10}" Margin="2,0,0,4" />
                                                        <TextBox Text="{Binding Network.Address, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Width="76" Margin="0,0,8,8">
                                                        <TextBlock Text="Porta" Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="{DynamicResource FontSize10}" Margin="2,0,0,4" />
                                                        <TextBox Text="{Binding Network.Port, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" />
                                                    </StackPanel>
                                                </WrapPanel>
                                            </Expander>
                                        </StackPanel>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="11"
                                                Padding="12,9" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="PC evidenziato" Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="{DynamicResource FontSize10}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Network.RemoteState}" Margin="0,3,0,0"
                                                           FontSize="{DynamicResource FontSize11}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12"
                                            Padding="14" Margin="0,14,0,12" Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="PC selezionato" Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="{DynamicResource FontSize10}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Network.RemoteState}" Margin="0,5,0,0"
                                                           FontSize="{DynamicResource FontSize12}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <WrapPanel Margin="0,11,0,0">
                                                <Button Content="Controlla stato" Style="{StaticResource SecondaryButton}"
                                                        IsEnabled="{Binding Network.CanContact}" Click="NetworkStatus_Click" />
                                                <Button Content="Avvia scansione" Style="{StaticResource RoundedButton}" Margin="8,0,0,0"
                                                        IsEnabled="{Binding Network.CanContact}" Click="NetworkScan_Click" />
                                                <Button Content="Aggiorna questo PC" Style="{StaticResource RoundedButton}" Margin="8,0,0,0"
                                                        IsEnabled="{Binding Network.CanUpdateCurrent}" Click="NetworkUpdateCurrent_Click" />
                                                <Button Content="Annulla" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                                        IsEnabled="{Binding Network.CanCancelCurrent}" Click="NetworkCancelCurrent_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="2" Margin="0,0,0,10" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Risultati dell'ultima scansione" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Network.ScanSummary}" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSize10}" Margin="0,3,10,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Network.ResultCount, StringFormat={}{0} update}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Network.WarningCount, StringFormat= · {0} avvisi}"
                                                       Foreground="{DynamicResource MutedTextBrush}" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="3" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="11" ClipToBounds="True" Visibility="Collapsed">
                                        <DataGrid ItemsSource="{Binding Network.ScanResults}" IsReadOnly="False" RowHeight="48"
                                                  HeadersVisibility="Column" SelectionUnit="FullRow" AutoGenerateColumns="False"
                                                  BorderThickness="0" Margin="0">
                                            <DataGrid.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridText}" />
                                            </DataGrid.Resources>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="42">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding CanInstall}" HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="75" IsReadOnly="True"
                                                                    ElementStyle="{StaticResource DataGridText}" />
                                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="1.5*" IsReadOnly="True"
                                                                    ElementStyle="{StaticResource DataGridText}" />
                                                <DataGridTextColumn Header="Installata" Binding="{Binding InstalledVersion}" Width="105" IsReadOnly="True"
                                                                    ElementStyle="{StaticResource DataGridText}" />
                                                <DataGridTextColumn Header="Disponibile" Binding="{Binding AvailableVersion}" Width="105" IsReadOnly="True"
                                                                    ElementStyle="{StaticResource DataGridText}" />
                                                <DataGridTemplateColumn Header="Conferma rischio" Width="115">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding RiskConfirmed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding RequiresRiskConfirmation}"
                                                                      Content="{Binding RiskLabel}" HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="110" IsReadOnly="True"
                                                                    ElementStyle="{StaticResource DataGridText}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" Background="Transparent"
                                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                      ToolTip="Trascina per ingrandire o ridurre l'elenco dei dispositivi">
                            <GridSplitter.Template>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Border Height="3" CornerRadius="2" Margin="80,0"
                                            Background="{DynamicResource BorderBrush}" />
                                </ControlTemplate>
                            </GridSplitter.Template>
                        </GridSplitter>

                        <Border x:Name="NetworkActionBar" Grid.Row="2" Margin="0" Padding="16,11"
                                CornerRadius="13" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Visibility="Collapsed">
                            <Grid x:Name="NetworkActionBarGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="NetworkActionButtonsRow" Height="0" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Network.SelectedComputerCount, StringFormat={}{0} PC pronti per operazioni}"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="NetworkActionHint"
                                               Text="Spunta uno o più dispositivi per abilitare le operazioni."
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <WrapPanel x:Name="NetworkActionButtons" Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Controlla stato" Style="{StaticResource SecondaryButton}"
                                            Padding="12,8" IsEnabled="{Binding Network.CanContact}"
                                            Click="NetworkStatus_Click" />
                                    <Button Content="{Binding Network.ScanActionText}" Style="{StaticResource RoundedButton}"
                                            Padding="14,8" Margin="8,0,0,0" IsEnabled="{Binding Network.CanScanTargets}"
                                            Click="NetworkScanSelected_Click" />
                                    <Button Content="Annulla" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Padding="12,8" IsEnabled="{Binding Network.CanCancelCurrent}"
                                            Click="NetworkCancelCurrent_Click" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,4,0,0"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="NetworkResultsHeaderGrid" Margin="18,15,18,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="NetworkResultsToolsRow" Height="0" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Aggiornamenti trovati" FontSize="{DynamicResource FontSize17}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Network.ScanSummary}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSize10}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <WrapPanel x:Name="NetworkResultsTools" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBox Width="142" ItemsSource="{Binding Network.ResultScopes}"
                                                  SelectedItem="{Binding Network.SelectedResultScope}"
                                                  DisplayMemberPath="Label" />
                                    </WrapPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <Grid>
                                    <DataGrid x:Name="NetworkResultsGrid" ItemsSource="{Binding Network.ResultsView}"
                                              IsReadOnly="False" RowHeight="60" MinRowHeight="60"
                                              HeadersVisibility="Column" SelectionUnit="FullRow" AutoGenerateColumns="False"
                                              BorderThickness="0" Margin="0" EnableRowVirtualization="True"
                                              CanUserResizeColumns="False" CanUserReorderColumns="False"
                                              CanUserSortColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              Visibility="Collapsed"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.Resources>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridText}" />
                                        </DataGrid.Resources>
                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="{x:Type GroupItem}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                    <Expander IsExpanded="True" Background="Transparent"
                                                                              HorizontalContentAlignment="Stretch"
                                                                              Width="{Binding ActualWidth, ElementName=NetworkResultsGrid}">
                                                                        <Expander.Header>
                                                                            <Border Background="{DynamicResource AccentSoftBrush}"
                                                                                    BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                                                                                    BorderThickness="0,0,0,1" Padding="14,9">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Expander.Header>
                                                                        <ItemsPresenter HorizontalAlignment="Stretch" />
                                                                    </Expander>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="46">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource ModernCheckBox}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanInstall}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn x:Name="NetworkResultNameColumn" Header="Aggiornamento"
                                                                    Width="1.35*" MinWidth="170" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource MutedTextBrush}"
                                                                           FontSize="{DynamicResource FontSize9}" />
                                                                <TextBlock Text=" · richiede conferma" FontSize="{DynamicResource FontSize9}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RequiresRiskConfirmation}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn x:Name="NetworkVersionsColumn" Header="Versioni"
                                                                    Width="1.55*" MinWidth="200" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="{DynamicResource FontSize10}"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="Installata: " /><Run Text="{Binding InstalledVersion, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock FontWeight="SemiBold" Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="Disponibile: " /><Run Text="{Binding AvailableVersion, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Stato" Width="1.1*" MinWidth="130" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ResultMessage}" Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="{DynamicResource FontSize9}" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultMessage}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid Margin="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="1.15*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="Aggiornamento" Margin="12,0,8,0"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                                           FontSize="{DynamicResource FontSize10}" />
                                                <TextBlock Grid.Column="2" Text="Tipo" Margin="12,0,8,0"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                                           FontSize="{DynamicResource FontSize10}" />
                                                <TextBlock Grid.Column="3" Text="Priorità" Margin="12,0,8,0"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                                           FontSize="{DynamicResource FontSize10}" />
                                                <TextBlock Grid.Column="4" Text="Versione attuale" Margin="12,0,8,0"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                                           FontSize="{DynamicResource FontSize10}" />
                                                <TextBlock Grid.Column="5" Text="Nuova versione" Margin="12,0,8,0"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                                           FontSize="{DynamicResource FontSize10}" />
                                                <TextBlock Grid.Column="6" Text="Dimensione" Margin="12,0,8,0"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                                           FontSize="{DynamicResource FontSize10}" />
                                                <TextBlock Grid.Column="7" Text="Stato" Margin="12,0,8,0"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                                           FontSize="{DynamicResource FontSize10}" />
                                            </Grid>
                                        </Border>

                                        <ListBox x:Name="NetworkResultsList" Grid.Row="1"
                                                 ItemsSource="{Binding Network.ResultsView}"
                                                 BorderThickness="0" Background="{DynamicResource InputBrush}"
                                                 HorizontalContentAlignment="Stretch" AlternationCount="2"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                            <Setter Property="Background" Value="{DynamicResource AlternateRowBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.ContainerStyle>
                                                        <Style TargetType="{x:Type GroupItem}">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                        <Expander IsExpanded="True" HorizontalContentAlignment="Stretch">
                                                                            <Expander.Header>
                                                                                <Border Background="{DynamicResource AccentSoftBrush}"
                                                                                        BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                                                                                        BorderThickness="0,0,0,1" Padding="12,9"
                                                                                        Width="{Binding ActualWidth, ElementName=NetworkResultsList}">
                                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                </Border>
                                                                            </Expander.Header>
                                                                            <ItemsPresenter HorizontalAlignment="Stretch" />
                                                                        </Expander>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </GroupStyle.ContainerStyle>
                                                </GroupStyle>
                                            </ListBox.GroupStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="60">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="115" />
                                                            <ColumnDefinition Width="1.15*" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" Style="{StaticResource ModernCheckBox}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanInstall}" />
                                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                            <TextBlock Text="{Binding Source}" Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="{DynamicResource FontSize9}" Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" CornerRadius="6" Padding="7,3" HorizontalAlignment="Left"
                                                                VerticalAlignment="Center" Background="#182563EB">
                                                            <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold"
                                                                       FontSize="{DynamicResource FontSize9}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DriverTypeBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Software">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SoftwareTypeBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Runtime">
                                                                                <Setter Property="Foreground" Value="{DynamicResource RuntimeTypeBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Margin="12,0,10,0" VerticalAlignment="Center"
                                                                   Text="{Binding PriorityLabel}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PriorityDescription}" />
                                                        <TextBlock Grid.Column="4" Margin="12,0,10,0" VerticalAlignment="Center"
                                                                   Text="{Binding InstalledVersion}" Foreground="{DynamicResource MutedTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding InstalledVersion}" />
                                                        <TextBlock Grid.Column="5" Margin="12,0,10,0" VerticalAlignment="Center"
                                                                   Text="{Binding AvailableVersion}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding AvailableVersion}" />
                                                        <TextBlock Grid.Column="6" Margin="12,0,10,0" VerticalAlignment="Center"
                                                                   Text="{Binding DownloadSizeLabel}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DownloadSizeLabel}" />
                                                        <StackPanel Grid.Column="7" Margin="12,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ResultMessage}"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="{DynamicResource FontSize9}" Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultMessage}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2" Margin="18,12,18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button Content="Seleziona tutto" Style="{StaticResource SecondaryButton}"
                                                Click="NetworkSelectVisibleUpdates_Click" />
                                        <Button Content="Deseleziona tutto" Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0" Click="NetworkDeselectVisibleUpdates_Click" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Network.ResultCount, StringFormat={}{0} risultati visibili}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="12,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Network.SelectedUpdateCount, StringFormat={}{0} selezionati}"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,0,14,0" />
                                        <Button Content="Aggiorna elementi selezionati" Style="{StaticResource RoundedButton}"
                                                IsEnabled="{Binding Network.CanUpdateSelected}"
                                                Click="NetworkUpdateSelected_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="NetworkStatusBar" Grid.Row="4" Margin="0,10,0,0" Padding="14,9" CornerRadius="11"
                                Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <TextBlock Text="{Binding Network.StatusText}" Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,180,0" />
                                <ProgressBar Width="160" Height="5" HorizontalAlignment="Right" IsIndeterminate="True">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Network.IsBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- CRONOLOGIA -->
                    <Grid x:Name="HistoryPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Margin="0,0,0,12" Padding="14,9" MinHeight="52"
                                Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="◷" Foreground="{DynamicResource AccentBrush}" FontSize="{DynamicResource FontSize16}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Registro aggiornamenti" FontWeight="SemiBold" FontSize="{DynamicResource FontSize14}" />
                                    <TextBlock Text="Esiti, versioni e spiegazioni delle operazioni eseguite"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border x:Name="HistoryHintBadge" Grid.Column="2" Padding="10,6" CornerRadius="9"
                                        Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="Dettagli completi dopo 1 secondo" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="{DynamicResource FontSize10}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History}" IsReadOnly="True"
                                      SelectionUnit="FullRow" VerticalContentAlignment="Center" Margin="0">
                                <DataGrid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridText}" />
                                    <Style x:Key="HistoryDateText" TargetType="TextBlock"
                                           BasedOn="{StaticResource DataGridText}">
                                        <Setter Property="Margin" Value="12,0,0,0" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" Binding="{Binding DisplayDate}" Width="135"
                                                        ElementStyle="{StaticResource HistoryDateText}" />
                                    <DataGridTemplateColumn Header="Nome" Width="1.25*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="{DynamicResource FontSize10}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Da" Binding="{Binding FromVersion}" Width="150" ElementStyle="{StaticResource DataGridText}" />
                                    <DataGridTextColumn Header="A" Binding="{Binding ToVersion}" Width="150" ElementStyle="{StaticResource DataGridText}" />
                                    <DataGridTemplateColumn Header="Esito" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="HistoryResultBadge" Padding="9,5" CornerRadius="8"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock x:Name="HistoryResultText" Text="{Binding Result}"
                                                               Foreground="{DynamicResource SuccessBrush}"
                                                               FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Result}" Value="Fallito">
                                                        <Setter TargetName="HistoryResultBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        <Setter TargetName="HistoryResultText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Dettagli" Width="2.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" Cursor="Hand"
                                                        MouseEnter="HistoryDetail_MouseEnter" MouseLeave="HistoryDetail_MouseLeave"
                                                        PreviewMouseDown="HistoryDetail_PreviewMouseDown"
                                                        PreviewMouseUp="HistoryDetail_PreviewMouseUp">
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource DataGridText}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Text="{Binding History.Count, StringFormat={}{0} operazioni registrate}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Apri log" Style="{StaticResource SecondaryButton}" Click="OpenLogs_Click" />
                                <Button Content="Cancella cronologia" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Click="ClearHistory_Click" />
                            </StackPanel>
                        </Grid>

                        <Popup x:Name="HistoryDetailPopup" Placement="Custom" AllowsTransparency="True"
                               PopupAnimation="Fade" StaysOpen="False" Closed="HistoryDetailPopup_Closed">
                            <Border Width="500" MaxHeight="360" Padding="18" Margin="8"
                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.20" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="Dettaglio attività" Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" />
                                        <Button Content="×" Style="{StaticResource WindowButton}" Width="30" Height="28"
                                                HorizontalAlignment="Right" Click="CloseHistoryDetail_Click" />
                                    </Grid>
                                    <TextBlock x:Name="HistoryDetailTitle" Grid.Row="1" Margin="0,8,0,10"
                                               FontWeight="SemiBold" FontSize="{DynamicResource FontSize16}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBox x:Name="HistoryDetailText" Grid.Row="2" MinHeight="92" MaxHeight="205"
                                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             SelectionBrush="{DynamicResource SelectionBrush}" />
                                    <Grid Grid.Row="3" Margin="0,12,0,0">
                                        <TextBlock x:Name="HistoryDetailStatus" Foreground="{DynamicResource SuccessBrush}"
                                                   FontSize="{DynamicResource FontSize11}" VerticalAlignment="Center" />
                                        <Button Content="Copia dettaglio" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Right" Padding="13,7" Click="CopyHistoryDetail_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- IMPOSTAZIONI -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Impostazioni" FontSize="{DynamicResource FontSize24}" FontWeight="SemiBold" />
                            <TextBlock Text="Controlla il comportamento di scansione e installazione" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,20" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Sicurezza" FontSize="{DynamicResource FontSize17}" FontWeight="SemiBold" Margin="0,0,0,16" />
                                    <CheckBox IsChecked="{Binding Settings.CreateRestorePoint}" Content="Crea un punto di ripristino per driver e aggiornamenti importanti" />
                                    <TextBlock Text="Viene richiesto un solo punto per l'intero gruppo. I soli aggiornamenti software non ne creano uno; lo spazio è gestito da Protezione sistema di Windows."
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" Margin="24,5,0,0" TextWrapping="Wrap" />
                                    <Button Content="Gestisci spazio in Windows" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Left" Margin="24,12,0,0" Padding="13,7"
                                            Click="OpenSystemProtection_Click" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Software" FontSize="{DynamicResource FontSize17}" FontWeight="SemiBold" Margin="0,0,0,16" />
                                    <CheckBox IsChecked="{Binding Settings.SilentSoftwareInstall}" Content="Richiedi a WinGet installazioni silenziose quando supportate" />
                                    <CheckBox IsChecked="{Binding Settings.IncludeUnknownVersions}" Margin="0,14,0,0"
                                              Content="Includi programmi la cui versione installata non è riconoscibile" />
                                    <TextBlock Text="Le versioni preview non vengono richieste: WinGet usa il canale stabile previsto dal pacchetto."
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" Margin="24,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Aggiornamenti di Update Center" FontSize="{DynamicResource FontSize17}"
                                               FontWeight="SemiBold" Margin="0,0,0,16" />
                                    <CheckBox IsChecked="{Binding Settings.CheckAppUpdatesAutomatically}"
                                              Content="Controlla automaticamente gli aggiornamenti" />
                                    <TextBlock Text="Il controllo usa esclusivamente le Release stabili ufficiali su GitHub e viene eseguito al massimo una volta ogni 24 ore."
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}"
                                               Margin="24,5,0,0" TextWrapping="Wrap" />
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ULTIMO CONTROLLO" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSize10}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LastAppUpdateCheckLabel}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding AppUpdateStatus}" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSize11}" Margin="0,3,18,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Controlla ora" Style="{StaticResource SecondaryButton}"
                                                IsEnabled="{Binding CanCheckAppUpdates}" VerticalAlignment="Center"
                                                Click="CheckForAppUpdates_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Aspetto" FontSize="{DynamicResource FontSize17}" FontWeight="SemiBold" />
                                    <TextBlock Text="Scegli il tema oppure segui automaticamente quello delle app di Windows."
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" Margin="0,5,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SystemThemeChoice" Content="Sistema" Tag="Sistema" GroupName="ThemeMode"
                                                     Style="{StaticResource ThemeChoice}" Click="ThemeChoice_Click" />
                                        <RadioButton x:Name="LightThemeChoice" Content="Chiaro" Tag="Chiaro" GroupName="ThemeMode"
                                                     Style="{StaticResource ThemeChoice}" Click="ThemeChoice_Click" />
                                        <RadioButton x:Name="DarkThemeChoice" Content="Scuro" Tag="Scuro" GroupName="ThemeMode"
                                                     Style="{StaticResource ThemeChoice}" Click="ThemeChoice_Click" />
                                    </StackPanel>
                                    <TextBlock Text="Dimensione del testo" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold" Margin="0,18,0,0" />
                                    <TextBlock Text="Piccola corrisponde alla precedente Media; Media e Grande aumentano progressivamente tutti i testi."
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" Margin="0,5,0,12" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SmallFontChoice" Content="Piccola" Tag="Piccola" GroupName="FontSizeMode"
                                                     Style="{StaticResource ThemeChoice}" Click="FontSizeChoice_Click" />
                                        <RadioButton x:Name="MediumFontChoice" Content="Media" Tag="Media" GroupName="FontSizeMode"
                                                     Style="{StaticResource ThemeChoice}" Click="FontSizeChoice_Click" />
                                        <RadioButton x:Name="LargeFontChoice" Content="Grande" Tag="Grande" GroupName="FontSizeMode"
                                                     Style="{StaticResource ThemeChoice}" Click="FontSizeChoice_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Avvio e scansioni automatiche" FontSize="{DynamicResource FontSize17}" FontWeight="SemiBold" Margin="0,0,0,16" />
                                    <CheckBox IsChecked="{Binding Settings.ScanAtStartup}" Content="Avvia automaticamente la scansione all'apertura" />
                                    <TextBlock Text="Frequenza scansione" FontWeight="SemiBold" Margin="0,17,0,8" />
                                    <ComboBox SelectedValue="{Binding Settings.AutomaticScanInterval, Mode=TwoWay}"
                                              SelectedValuePath="Tag" Width="220" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Disattivata" Tag="Off" />
                                        <ComboBoxItem Content="Ogni giorno" Tag="Daily" />
                                        <ComboBoxItem Content="Ogni settimana" Tag="Weekly" />
                                    </ComboBox>
                                    <TextBlock Text="La scansione periodica viene eseguita mentre Update Center è aperto oppure al successivo avvio, se è scaduta. L'installazione richiede sempre la tua conferma."
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}"
                                               Margin="0,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Notifiche" FontSize="{DynamicResource FontSize17}" FontWeight="SemiBold" Margin="0,0,0,16" />
                                    <CheckBox IsChecked="{Binding Settings.NotifyWhenUpdatesAreAvailable}"
                                              Content="Avvisami quando vengono trovati aggiornamenti" />
                                    <TextBlock Text="Le notifiche sono locali e non richiedono account o servizi di telemetria."
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}"
                                               Margin="24,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Lingua" FontSize="{DynamicResource FontSize17}" FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ItalianLanguageChoice" Content="Italiano" Tag="it" GroupName="LanguageMode"
                                                     Style="{StaticResource ThemeChoice}" Click="LanguageChoice_Click" />
                                        <RadioButton x:Name="EnglishLanguageChoice" Content="Inglese" Tag="en" GroupName="LanguageMode"
                                                     Style="{StaticResource ThemeChoice}" Click="LanguageChoice_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Informazioni sul progetto" FontSize="{DynamicResource FontSize17}" FontWeight="SemiBold" />
                                    <TextBlock Text="Update Center per Windows 10 e Windows 11"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,16" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Ideato e sviluppato da" Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Text="Illidan0S" FontWeight="SemiBold" Margin="0,5,12,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Versione installata" Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock x:Name="AboutVersionText" FontWeight="SemiBold" Margin="0,5,12,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Licenza" Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Text="MIT" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Update Center non raccoglie dati personali e non include telemetria."
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,16,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Scansioni, impostazioni, cronologia e log restano memorizzati localmente sul computer."
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    <Button Content="Apri GitHub" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                            Margin="0,14,0,0" Tag="https://github.com/Illidan0S/UpdateCenter" Click="OpenVendorSupport_Click" />
                                </StackPanel>
                            </Border>
                            <Button Content="Salva impostazioni" Style="{StaticResource RoundedButton}" HorizontalAlignment="Left"
                                    Margin="0,18,0,0" Click="SaveSettings_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
