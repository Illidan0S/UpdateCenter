                                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="NoWrap" Style="{DynamicResource OperationsText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize9}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{DynamicResource OperationsText}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource ManagementTextConverter}" ConverterParameter="">
                                                                <Binding Path="ResultMessage" />
                                                                <Binding Path="Language" RelativeSource="{RelativeSource Self}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                        <TextBlock.ToolTip>
                                                            <MultiBinding Converter="{StaticResource ManagementTextConverter}" ConverterParameter="">
                                                                <Binding Path="ResultMessage" />
                                                                <Binding Path="Language" RelativeSource="{RelativeSource Self}" />
                                                            </MultiBinding>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border x:Name="NetworkResultsEmptyState" Background="{DynamicResource SurfaceBrush}" Padding="20" IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=NetworkResultsGrid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Nessun aggiornamento da visualizzare. Consulta lo stato della scansione." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="18,12,18,14" x:Name="NetworkResultsFooter">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Seleziona tutto" Style="{DynamicResource ManagementButton}" Click="NetworkSelectVisibleUpdates_Click" />
                            <Button Content="Deseleziona tutto" Style="{DynamicResource ManagementButton}" Margin="8,0,0,0" Click="NetworkDeselectVisibleUpdates_Click" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Network.VisibleResultsLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="12,0" TextWrapping="Wrap" x:Name="NetworkVisibleResultsText" />
                        <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" x:Name="NetworkResultsFooterActions">
                            <TextBlock Text="{Binding Network.SelectedUpdatesLabel}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,14,0" TextWrapping="Wrap" />
                            <Button Content="Aggiorna elementi selezionati" Style="{DynamicResource ManagementPrimaryButton}" IsEnabled="{Binding Network.CanUpdateSelected}" Click="NetworkUpdateSelected_Click" x:Name="NetworkUpdateSelectedButton" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="NetworkStatusBar" Grid.Row="4" Margin="0,10,0,0" Padding="14,9" CornerRadius="11" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Network.StatusText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0" />
                    <ProgressBar Height="5" HorizontalAlignment="Stretch" IsIndeterminate="True" Grid.Row="1" Margin="0,8,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Network.IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Grid>

                    <!-- CRONOLOGIA -->
                    <Grid x:Name="HistoryPage" Visibility="Collapsed">
<Grid.Resources><ResourceDictionary Source="Styles/Operations.xaml" /></Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Margin="0,0,0,12" Padding="14,9" MinHeight="52"
                                Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="◷" Foreground="{DynamicResource AccentBrush}" FontSize="{DynamicResource FontSize16}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Registro aggiornamenti" FontWeight="SemiBold" FontSize="{DynamicResource FontSize24}" />
                                    <TextBlock Text="Esiti, versioni e spiegazioni delle operazioni eseguite"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border x:Name="HistoryHintBadge" AutomationProperties.HelpText="{Binding Path=(AutomationProperties.HelpText), ElementName=HistoryHintBadge}" Grid.Column="2" Padding="10,6" CornerRadius="9"
                                        Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Path=(AutomationProperties.HelpText), ElementName=HistoryHintBadge}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="{DynamicResource FontSize10}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{DynamicResource OperationsCard}" Padding="0" ClipToBounds="True">
                            <Grid>
<DataGrid Style="{DynamicResource OperationsGrid}" x:Name="HistoryGrid" AutomationProperties.Name="{DynamicResource OperationsHistoryText}" ItemsSource="{Binding History}" IsReadOnly="True"
                                      SelectionUnit="FullRow" VerticalContentAlignment="Center" Margin="0">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource OperationsCell}" />
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource OperationsColumnHeader}" />
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource OperationsRow}" />
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OperationsText}" />
                                    <Style x:Key="HistoryDateText" TargetType="TextBlock"
                                           BasedOn="{StaticResource OperationsText}">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" SortMemberPath="Timestamp" Binding="{Binding DisplayDate}" Width="155" MinWidth="155"
                                                        ElementStyle="{StaticResource HistoryDateText}" />
                                    <DataGridTemplateColumn Header="Nome" SortMemberPath="Name" Width="1.25*" MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{DynamicResource OperationsText}" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{DynamicResource OperationsText}" Text="{Binding Kind}" Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="{DynamicResource FontSize10}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Da" Binding="{Binding FromVersion}" Width="130" MinWidth="130" ElementStyle="{StaticResource OperationsText}" />
                                    <DataGridTextColumn Header="A" Binding="{Binding ToVersion}" Width="130" MinWidth="130" ElementStyle="{StaticResource OperationsText}" />
                                    <DataGridTemplateColumn Header="Esito" SortMemberPath="Result" Width="145" MinWidth="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="HistoryResultBadge" Padding="9,5" CornerRadius="8"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock Style="{DynamicResource OperationsText}" x:Name="HistoryResultText" Text="{Binding DisplayResult}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Result}" Value="Fallito">
                                                        <Setter TargetName="HistoryResultBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        <Setter TargetName="HistoryResultText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DisplayResult}" Value="Non riuscito">
                                                        <Setter TargetName="HistoryResultBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DisplayResult}" Value="Failed">
                                                        <Setter TargetName="HistoryResultBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Dettagli" SortMemberPath="Details" Width="2.5*" MinWidth="240">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button x:Name="HistoryDetailButton" Click="HistoryDetail_Click" Style="{DynamicResource OperationsDetailButton}"
                                                        AutomationProperties.Name="{DynamicResource OperationsDetailsText}" AutomationProperties.HelpText="{Binding DisplayDetails}">
                                                    <TextBlock Text="{Binding DisplayDetails}" Style="{DynamicResource OperationsText}" MaxHeight="56" TextWrapping="Wrap" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
<Border x:Name="HistoryEmptyState" Background="{DynamicResource SurfaceBrush}" Margin="1,48,1,1" Padding="24" IsHitTestVisible="False">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=HistoryGrid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style></Border.Style>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
            <TextBlock Text="Nessuna operazione registrata" FontSize="{DynamicResource FontSize18}" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="Le operazioni eseguite compariranno qui con esito, versioni e dettagli." Style="{DynamicResource AppearanceDescription}" TextAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Text="{Binding HistoryCountLabel}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Apri log" Style="{DynamicResource SettingsButton}" Click="OpenLogs_Click" />
                                <Button Content="Cancella cronologia" Style="{DynamicResource SettingsButton}"
                                        Margin="8,0,0,0" Click="ClearHistory_Click" />
                            </StackPanel>
                        </Grid>

                        <Popup x:Name="HistoryDetailPopup" Placement="Custom" AllowsTransparency="True" StaysOpen="False"
