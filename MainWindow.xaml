                                    PreviewKeyDown="HistoryPopup_PreviewKeyDown">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Path=(AutomationProperties.Name), ElementName=HistoryDetailContent}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSize12}" Margin="0,0,36,0" TextWrapping="Wrap" />
                                        <Button x:Name="HistoryDetailCloseButton" Content="{StaticResource WindowCloseIcon}" Style="{StaticResource ShellWindowButton}"
                                                AutomationProperties.Name="{DynamicResource OperationsCloseText}" Width="30" Height="28"
                                                HorizontalAlignment="Right" Click="CloseHistoryDetail_Click" />
                                    </Grid>
                                    <ScrollViewer x:Name="HistoryDetailScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <StackPanel>
                                            <TextBlock x:Name="HistoryDetailTitle" Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize16}"
                                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8" />
                                            <TextBox x:Name="HistoryDetailText" AutomationProperties.Name="{DynamicResource OperationsDetailsText}" Style="{DynamicResource OperationsSearch}"
                                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                     BorderThickness="0" Padding="0" Background="Transparent"
                                                     HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

