<Window x:Class="UpdateCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ux="clr-namespace:UpdateCenter.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Update Center" Icon="Assets/UpdateCenter.ico" Width="1240" Height="790" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" AllowsTransparency="False"
        ResizeMode="CanResize" Background="{DynamicResource BackgroundBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Styles/Shell.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize15}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="WindowBorder" CornerRadius="0" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Margin="20,0,18,0" VerticalAlignment="Center">
                    <Image Source="Assets/UpdateCenter.ico" Width="26" Height="26" Stretch="Uniform" AutomationProperties.Name="Update Center" />
                    <TextBlock x:Name="AppNameText" Text="Update Center" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="{DynamicResource FontSize14}" />
                    <Border x:Name="VersionBadge" Margin="8,0,0,0" Padding="7,3" VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                            BorderThickness="1" CornerRadius="7">
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextBrush}"
                                   FontSize="{DynamicResource FontSize10}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="PageTitle" Text="Home" Foreground="{DynamicResource TextBrush}"
                           FontSize="{DynamicResource FontSize13}" FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="12,0" />
                <StackPanel shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource ShellWindowButton}" Content="{StaticResource WindowMinimizeIcon}" Click="Minimize_Click" />
                    <Button x:Name="MaximizeWindowButton" Click="Maximize_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ShellWindowButton}">
                                <Setter Property="Content" Value="{StaticResource WindowMaximizeIcon}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Content" Value="{StaticResource WindowRestoreIcon}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource ShellWindowButton}" Content="{StaticResource WindowCloseIcon}" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="12,0,0,12" CornerRadius="18" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SidebarHeading" Text="CONTROLLO PC" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}"
                                   FontWeight="SemiBold" Margin="12,10,0,12" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,4">
                            <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                                <Button x:Name="HomeNav" Style="{StaticResource ShellNavigationButton}" Content="Home" Click="HomeNav_Click">
                                    <Button.Resources><PathGeometry x:Key="NavigationIcon" Figures="M3,10 L12,3 L21,10 M6,9 V21 H18 V9" /></Button.Resources>
                                </Button>
                                <Button x:Name="UpdatesNav" Style="{StaticResource ShellNavigationButton}" Content="Aggiornamenti" Click="UpdatesNav_Click">
                                    <Button.Resources><PathGeometry x:Key="NavigationIcon" Figures="M12,3 V16 M6,10 L12,16 L18,10 M4,18 V21 H20 V18" /></Button.Resources>
                                </Button>
                                <Button x:Name="SystemInfoNav" Style="{StaticResource ShellNavigationButton}" Content="Hardware" Click="SystemInfoNav_Click">
                                    <Button.Resources><PathGeometry x:Key="NavigationIcon" Figures="M3,4 H21 V17 H3 Z M8,21 H16 M12,17 V21" /></Button.Resources>
                                </Button>
                                <Button x:Name="HardwareNav" Style="{StaticResource ShellNavigationButton}" Content="Driver e chipset" Click="HardwareNav_Click">
                                    <Button.Resources><PathGeometry x:Key="NavigationIcon" Figures="M6,6 H18 V18 H6 Z M9,9 H15 V15 H9 Z M9,3 V6 M15,3 V6 M9,18 V21 M15,18 V21 M3,9 H6 M3,15 H6 M18,9 H21 M18,15 H21" /></Button.Resources>
                                </Button>
                                <Button x:Name="HistoryNav" Style="{StaticResource ShellNavigationButton}" Content="Cronologia" Click="HistoryNav_Click">
                                    <Button.Resources><PathGeometry x:Key="NavigationIcon" Figures="M12,3 A9,9 0 1 0 21,12 A9,9 0 0 0 12,3 M12,7 V12 L16,14" /></Button.Resources>
                                </Button>
                                <Button x:Name="NetworkNav" Style="{StaticResource ShellNavigationButton}" Content="Gestione rete" Click="NetworkNav_Click">
                                    <Button.Resources><PathGeometry x:Key="NavigationIcon" Figures="M9,2 H15 V8 H9 Z M2,16 H8 V22 H2 Z M16,16 H22 V22 H16 Z M12,8 V12 M5,16 V12 H19 V16" /></Button.Resources>
                                </Button>
                                <Button x:Name="SettingsNav" Style="{StaticResource ShellNavigationButton}" Content="Impostazioni" Click="SettingsNav_Click">
                                    <Button.Resources><PathGeometry x:Key="NavigationIcon" Figures="M4,4 H20 M4,12 H20 M4,20 H20 M8,1 V7 M16,9 V15 M10,17 V23" /></Button.Resources>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Border x:Name="SidebarSourceCard" Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14" Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Controllo locale" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" />
                                <TextBlock Text="Nessuna telemetria" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{DynamicResource FontSize11}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid x:Name="ContentHost" Grid.Column="1" Margin="18,0,18,18">
                    <!-- HOME -->
                    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel x:Name="HomeContent" MaxWidth="1100">
                            <StackPanel.Resources>
                                <ResourceDictionary Source="Styles/Settings.xaml" />
                            </StackPanel.Resources>
                            <Border x:Name="HomeAppUpdateNotice" Visibility="{Binding HasAppUpdateNotice, Converter={StaticResource BooleanToVisibility}}"
                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="1.5" Margin="0,4" />
                                    <TextBlock Grid.Column="1" Text="{Binding AppUpdateNotice}" FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,12,0" AutomationProperties.LiveSetting="Polite" />
                                    <Button x:Name="HomeAppUpdateButton" Grid.Column="2" Content="Vedi novità" Style="{DynamicResource SettingsButton}"
                                            IsEnabled="{Binding CanCheckAppUpdates}" Click="OpenAppUpdate_Click" />
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="Mantieni il PC aggiornato" FontSize="{DynamicResource FontSize27}" FontWeight="SemiBold" />
                                    <TextBlock Text="Controlla software e driver da fonti ufficiali, poi scegli tu cosa installare."
                                               Style="{DynamicResource AppearanceDescription}" Margin="0,8,0,18" />
                                    <WrapPanel>
                                        <Button x:Name="HomeScanButton" Content="Avvia scansione" Style="{DynamicResource SettingsSaveButton}"
                                                IsEnabled="{Binding CanScan}" Click="Scan_Click" Margin="0,0,12,0" />
                                        <Button x:Name="HomeCancelButton" Content="Annulla" IsEnabled="{Binding IsScanRunning}" Click="CancelScan_Click"
                                                Style="{DynamicResource SettingsButton}"
                                                Visibility="{Binding IsScanRunning, Converter={StaticResource BooleanToVisibility}}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="HomeStatusCard" Style="{DynamicResource SettingsCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock x:Name="HomeActivityLabel" Text="Stato" Style="{DynamicResource AppearanceDescription}" />
                                            <TextBlock x:Name="HomeStatusText" Text="{Binding StatusText}" FontSize="{DynamicResource FontSize18}"
                                                       FontWeight="SemiBold" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="Avanzamento" Style="{DynamicResource AppearanceDescription}" />
                                            <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar x:Name="HomeProgress" Style="{StaticResource ScanProgressBar}" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate}" Maximum="100" Height="6"
                                                 Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,12"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=HomeActivityLabel}" />
                                    <TextBlock x:Name="HomeCurrentItemText" Text="{Binding CurrentItemText}" Style="{DynamicResource AppearanceDescription}" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{DynamicResource SettingsCard}" Margin="0" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="Elementi trovati" Style="{DynamicResource AppearanceDescription}" />
                                        <TextBlock x:Name="HomeScannedCount" Text="{Binding ScannedCount}" FontSize="{DynamicResource FontSize30}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{DynamicResource SettingsCard}" Margin="0" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="Aggiornamenti" Style="{DynamicResource AppearanceDescription}" />
                                        <TextBlock x:Name="HomeAvailableCount" Text="{Binding AvailableCount}" FontSize="{DynamicResource FontSize30}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{DynamicResource SettingsCard}" Margin="0" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="Selezionati" Style="{DynamicResource AppearanceDescription}" />
                                        <TextBlock x:Name="HomeSelectedCount" Text="{Binding SelectedCount}" FontSize="{DynamicResource FontSize30}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{DynamicResource SettingsCard}" Margin="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="HomeLastScanActionsRow" Height="0" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="HomeLastScanDetails">
                                        <TextBlock Text="Ultima scansione" Style="{DynamicResource AppearanceDescription}" />
                                        <TextBlock x:Name="HomeLastScanText" Text="{Binding LastScanLabel}" FontSize="{DynamicResource FontSize17}" FontWeight="SemiBold" Margin="0,6,0,4" />
                                        <TextBlock Text="{Binding HomeScanSummary}" Style="{DynamicResource AppearanceDescription}" />
                                    </StackPanel>
                                    <Button x:Name="HomeViewUpdatesButton" Grid.Column="1" Content="Vedi aggiornamenti" Style="{DynamicResource SettingsButton}"
                                            VerticalAlignment="Center" Margin="20,0,0,0" Click="OpenUpdates_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- AGGIORNAMENTI -->
                    <Grid x:Name="UpdatesPage" Visibility="Collapsed">
<Grid.Resources><ResourceDictionary Source="Styles/Operations.xaml" /></Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="UpdatesSectionsViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Aggiornamenti" FontSize="{DynamicResource FontSize24}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ShowProgressButton" Content="Mostra avanzamento" Style="{DynamicResource SettingsSaveButton}"
                                        Visibility="Collapsed" Margin="0,0,8,0" Click="ShowProgress_Click" />
                                <Button Content="Nuova scansione" Style="{DynamicResource SettingsButton}"
                                        IsEnabled="{Binding CanScan}" Click="Scan_Click" />
                            </WrapPanel>
                            </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="UpdateFilterColumn" Width="165" />

                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,10,0">
                                <TextBox x:Name="UpdateSearchBox" AutomationProperties.Name="{DynamicResource OperationsSearchUpdatesText}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Cerca per nome, produttore, versione, fonte o stato"
                                         Style="{DynamicResource OperationsSearch}" />
                                <TextBlock Text="Cerca aggiornamenti" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="13,0,8,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=UpdateSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ComboBox x:Name="UpdateTypeChoice" AutomationProperties.Name="{DynamicResource OperationsUpdateFilterText}" Style="{DynamicResource SettingsComboBox}" Grid.Column="1" SelectedValue="{Binding UpdateTypeFilter}" SelectedValuePath="Tag"
                                      ToolTip="Filtra gli aggiornamenti">
                                <ComboBoxItem Content="Tutti" Tag="Tutti" />
                                <ComboBoxItem Content="Software" Tag="Software" />
                                <ComboBoxItem Content="Driver" Tag="Driver" />
                                <ComboBoxItem Content="Runtime" Tag="Runtime" />
                                <ComboBoxItem Content="Errori" Tag="Errori" />
                            </ComboBox>
                        </Grid>
                            <Border x:Name="UpdatesActivity" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,8"
                                    Visibility="{Binding ShowUpdatesActivity, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize12}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentItemText}" Style="{DynamicResource OperationsText}" Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                    <ProgressBar x:Name="UpdatesScanProgress" Style="{StaticResource ScanProgressBar}" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate}" Maximum="100" Height="3" Margin="0,7,0,0"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"
                                                 AutomationProperties.Name="{DynamicResource OperationsProgressText}" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="UpdateAvailabilityText" Text="{Binding UpdateAvailabilityLabel}" Margin="0,8,0,0"
                                       FontSize="{DynamicResource FontSize12}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        <Border x:Name="ManagedUpdatesSection" Style="{DynamicResource OperationsCard}" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding ManagedUpdatesHeader}" FontWeight="SemiBold" Margin="12,7" TextWrapping="Wrap" />
                            <Grid Grid.Row="1">
<ux:PageScrollingDataGrid Page="{Binding ElementName=UpdatesSectionsViewport}">
<DataGrid Style="{DynamicResource OperationsGrid}" x:Name="UpdatesGrid" AutomationProperties.Name="{Binding ManagedUpdatesHeader}" ItemsSource="{Binding ManagedUpdatesView}"
                                      IsReadOnly="False" SelectionUnit="FullRow" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="0">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource OperationsCell}" />
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource OperationsColumnHeader}" />
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource OperationsRow}" />
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OperationsText}" />
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="56" MinWidth="56" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <CheckBox Style="{DynamicResource SettingsCheckBox}" AutomationProperties.Name="{Binding Name}"
                                                              IsEnabled="{Binding CanInstall}" Checked="UpdateSelection_Changed" Unchecked="UpdateSelection_Changed"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Nome" SortMemberPath="Name" Width="2.2*" MinWidth="190" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{DynamicResource OperationsText}" Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Style="{DynamicResource OperationsText}" Text="{Binding KindLabel}" FontSize="{DynamicResource FontSize10}" Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Style="{DynamicResource OperationsText}" Text="{Binding SourceSummary}" Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="{DynamicResource FontSize10}" Margin="0,3,0,0"
                                                               ToolTip="{Binding CompatibilityDetail}" />
                                                    <Button Content="{DynamicResource OperationsReleaseNotesText}" Click="ReleaseNotes_Click" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="6,2" Style="{DynamicResource SettingsButton}" AutomationProperties.Name="{DynamicResource OperationsReleaseNotesLabel}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Priorità" SortMemberPath="PriorityLabel" Width="120" MinWidth="120" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="PriorityBadge" CornerRadius="8" Padding="9,5" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}">
                                                    <Border.ToolTip>
                                                        <ToolTip Content="{Binding PriorityDescription}" Style="{StaticResource WrappedToolTip}" />
                                                    </Border.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Style="{DynamicResource OperationsText}" x:Name="PriorityText" Text="{Binding PriorityLabel}" Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="{DynamicResource FontSize11}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{DynamicResource OperationsRestartText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource OperationsText}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RequiresRestart}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding PriorityLabel}" Value="Importante">
                                                        <Setter TargetName="PriorityBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        <Setter TargetName="PriorityText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PriorityLabel}" Value="Important">
                                                        <Setter TargetName="PriorityBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        <Setter TargetName="PriorityText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PriorityLabel}" Value="Facoltativo">
                                                        <Setter TargetName="PriorityBadge" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                        <Setter TargetName="PriorityText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PriorityLabel}" Value="Optional">
                                                        <Setter TargetName="PriorityBadge" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                        <Setter TargetName="PriorityText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Versioni" SortMemberPath="AvailableVersion" Width="190" MinWidth="190" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Style="{DynamicResource OperationsText}" Text="{DynamicResource OperationsInstalledText}" FontSize="{DynamicResource FontSize10}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" Style="{DynamicResource OperationsText}" />
                                                    <TextBlock Style="{DynamicResource OperationsText}" Grid.Row="1" Text="{DynamicResource OperationsAvailableText}" FontSize="{DynamicResource FontSize10}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,8,0" />
