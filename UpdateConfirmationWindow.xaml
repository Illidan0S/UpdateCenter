<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="UpdateCenter.UpdateConfirmationWindow" Title="Conferma aggiornamenti" Width="720" Height="600" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" Background="Transparent" ShowInTaskbar="False" MinWidth="480" MinHeight="320" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="Styles/Dialogs.xaml" />
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="18,10,12,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MinHeight="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Riepilogo prima dell'installazione" FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0" />
                <Button Content="×" Style="{DynamicResource DialogButton}" Width="36" Height="34" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cancel_Click" Grid.Column="1" AutomationProperties.Name="{DynamicResource DialogCloseText}" ToolTip="{DynamicResource DialogCloseText}" />
            </Grid>
            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,12,20,16" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConfirmationPurposeText" Text="Controlla gli elementi: l'installazione inizierà solo dopo la tua conferma." Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,18" TextWrapping="Wrap" />
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="ImportantHeadingText" Text="IMPORTANTI" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ImportantCountText" FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="SOFTWARE / RUNTIME" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" TextWrapping="Wrap" />
                                <TextBlock x:Name="SoftwareCountText" FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="DRIVER" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" TextWrapping="Wrap" />
                                <TextBlock x:Name="DriverCountText" FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,14">
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="ALIMENTAZIONE" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PowerStatusText" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="DiskHeadingText" Text="SPAZIO SU DISCO" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" TextWrapping="Wrap" />
                                <TextBlock x:Name="DiskStatusText" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border x:Name="RestorePointPanel" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Protezione del sistema" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="RestorePointText" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="BlockingPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="Prima di continuare risolvi questi problemi" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <ItemsControl x:Name="BlockingList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•  " Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel x:Name="WarningsPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="Avvisi prima di continuare" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <ItemsControl x:Name="WarningsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•  " TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Grid.Column="1" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border x:Name="RiskConfirmationPanel" Visibility="Collapsed" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="RiskHeadingText" Text="Aggiornamenti con rimozione preventiva" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="RiskDescriptionText" Margin="0,5,0,8" TextWrapping="Wrap" Text="Questi installer possono rimuovere la versione funzionante prima di installare quella nuova. Se l'installazione fallisce, il programma potrebbe dover essere reinstallato manualmente:" />
                            <ItemsControl x:Name="RiskItemsList" Margin="0,0,0,9">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold" Margin="0,2" TextWrapping="Wrap">
                                            <Run Text="•  " />
                                            <Run Text="{Binding Path=., Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox x:Name="RiskAcceptanceCheckBox" Content="Ho compreso il rischio e voglio eseguire comunque questi aggiornamenti" Checked="RiskAcceptanceChanged" Unchecked="RiskAcceptanceChanged" Style="{DynamicResource DialogCheckBox}" />
                            <Button x:Name="ExcludeRiskItemsButton" Content="Continua senza questi aggiornamenti" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{DynamicResource DialogButton}" Click="ExcludeRiskItems_Click" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ItemsGridBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DataGrid x:Name="ItemsGrid" IsReadOnly="True" MaxHeight="230" Style="{DynamicResource OperationsGrid}" MinRowHeight="48" CanUserSortColumns="False" AutomationProperties.Name="{DynamicResource DialogItemsText}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="ItemsGrid_PreviewMouseWheel">
                            <DataGrid.Resources>
            <DataTemplate x:Key="InstallationProgramCell">
                <StackPanel Margin="8,7">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PermissionLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource WarningBrush}" FontSize="{DynamicResource FontSize11}" Margin="0,5,0,0" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasWarning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource OperationsCell}" />
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource OperationsColumnHeader}" />
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource OperationsRow}" />
                                <Style TargetType="TextBlock" BasedOn="{StaticResource OperationsText}" />
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="DeviceColumn" Header="PC" Binding="{Binding DeviceName}" Width="110" Visibility="Collapsed" ElementStyle="{StaticResource OperationsText}" MinWidth="120" />
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource OperationsText}" MinWidth="180" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding KindLabel}" Width="80" ElementStyle="{StaticResource OperationsText}" MinWidth="120" />
                                <DataGridTextColumn Header="Priorità" Binding="{Binding PriorityLabel}" Width="105" ElementStyle="{StaticResource OperationsText}" MinWidth="120" />
                                <DataGridTextColumn Header="Nuova versione" Binding="{Binding AvailableVersion}" Width="130" ElementStyle="{StaticResource OperationsText}" MinWidth="120" />
                                <DataGridTextColumn Header="Riavvio" Binding="{Binding RestartLabel}" Width="75" ElementStyle="{StaticResource OperationsText}" MinWidth="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,14,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,12" x:Name="DialogFooter">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FooterInfoText" Text="Verrà mostrata la richiesta amministratore di Windows." Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" Margin="0,10,0,0" x:Name="DialogActions">
                        <Button Content="Annulla" Style="{DynamicResource DialogButton}" Click="Cancel_Click" x:Name="CancelButton" />
                        <Button x:Name="ConfirmButton" Content="Conferma e aggiorna" Style="{DynamicResource DialogPrimaryButton}" Margin="10,0,0,0" Click="Confirm_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
