<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
    <AssemblyName>UpdateCenter.FutureFixture.$(FixtureKind)</AssemblyName>
    <Version>$(FixtureVersion)</Version>
    <AssemblyVersion>$(FixtureVersion).0</AssemblyVersion>
    <FileVersion>$(FixtureVersion).0</FileVersion>
    <InformationalVersion>$(FixtureVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixture.txt" LogicalName="Fixture.txt" />
  </ItemGroup>
  <Target Name="CheckFixtureParameters" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(FixtureKind)' != 'Portable' And '$(FixtureKind)' != 'Setup'"
           Text="FixtureKind must be Portable or Setup." />
    <Error Condition="'$(FixtureVersion)' != '2.0.2' And '$(FixtureVersion)' != '2.4.0'"
           Text="FixtureVersion must be 2.0.2 or 2.4.0." />
  </Target>
</Project>
