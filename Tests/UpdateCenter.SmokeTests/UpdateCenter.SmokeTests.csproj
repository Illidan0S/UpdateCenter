<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Native diagnostics must observe the same Windows compatibility contract
         as the product (in particular fixed file-version API results). -->
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures\WinGetB2\*.yaml" />
    <EmbeddedResource Include="Fixtures\AutomaticVerification\*.yaml" />
    <ProjectReference Include="..\..\UpdateCenter.csproj" />
    <ProjectReference Include="..\..\Agent\UpdateCenter.Agent.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
