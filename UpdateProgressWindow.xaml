<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="UpdateCenter.UpdateProgressWindow" Title="Installazione aggiornamenti" Width="720" Height="520" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" Background="Transparent" ShowInTaskbar="False" MinWidth="480" MinHeight="320" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="Styles/Dialogs.xaml" />
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="18,10,12,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MinHeight="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WindowTitleText" Text="Installazione aggiornamenti" FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1">
                    <Button Content="—" Style="{DynamicResource DialogButton}" ToolTip="{DynamicResource DialogMinimizeText}" Width="36" Height="34" Padding="0" Click="Minimize_Click" AutomationProperties.Name="{DynamicResource DialogMinimizeText}" />
                    <Button x:Name="HeaderCloseButton" Content="×" Style="{DynamicResource DialogButton}" ToolTip="{DynamicResource DialogHideText}" Width="36" Height="34" Padding="0" Margin="8,0,0,0" Click="Close_Click" AutomationProperties.Name="{DynamicResource DialogHideText}" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,12" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border x:Name="CompletionSummary" CornerRadius="12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    <Border x:Name="StateIcon" Visibility="Collapsed" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBorderBrush}" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock x:Name="StateIconText" Text="↻" Foreground="{DynamicResource AccentBrush}" FontSize="{DynamicResource FontSize27}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StateTitleText" Text="Aggiornamento in corso" FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBox x:Name="StateDetailText" Text="{Binding CurrentItemText, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,10" TextWrapping="Wrap" Style="{DynamicResource ManagementValue}" />
                    </StackPanel>
                      </Grid>
                    </Border>
                    <Border x:Name="ActivityContainer" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14" Padding="12">
                        <StackPanel>
                            <Grid x:Name="ActivityHeader">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ActivityTitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="PercentageText" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Grid.Column="1" />
                            </Grid>
                            <ProgressBar x:Name="InstallationProgressBar" Maximum="100" Height="8" Margin="0,8,0,6" Style="{DynamicResource UpdateCenterProgressBar}" Background="{DynamicResource BorderBrush}" AutomationProperties.Name="{Binding Text, ElementName=ActivityTitleText}" />
                            <TextBox x:Name="OperationStatusText" Text="{Binding StatusText, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" TextWrapping="Wrap" Style="{DynamicResource ManagementValue}" />
                            <TextBlock x:Name="BatchProgressText" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="PauseHintText" Text="{Binding UpdatePauseHint, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" Margin="0,6,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <UniformGrid x:Name="ResultCards" Columns="2" Margin="0,16,0,0" Visibility="Collapsed">
                        <Border x:Name="VerifiedResultCard" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="VerifiedCountLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" TextWrapping="Wrap" />
                                <TextBlock x:Name="SucceededCountText" Foreground="{DynamicResource SuccessBrush}" FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="FailedResultCard" Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="NON RIUSCITI" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" TextWrapping="Wrap" />
                                <TextBlock x:Name="FailedCountText" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="NotApplicableResultCard" Visibility="Collapsed" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="NotApplicableCountLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize10}" TextWrapping="Wrap" />
                                <TextBlock x:Name="NotApplicableCountText" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border x:Name="CompletionNotice" Visibility="Collapsed" Margin="0,14,0,0" Background="{DynamicResource WarningSoftBrush}" CornerRadius="10" Padding="14">
                        <TextBlock x:Name="CompletionNoticeText" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel x:Name="OperationItemsPanel" Margin="0,12,0,0">
                        <TextBlock Text="Elementi dell'operazione" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid x:Name="OperationItemsGrid" IsReadOnly="True" MaxHeight="360" MinHeight="80" SelectionMode="Single" Style="{DynamicResource OperationsGrid}" MinRowHeight="48" CanUserSortColumns="False" AutomationProperties.Name="{DynamicResource DialogItemsText}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="OperationItemsGrid_PreviewMouseWheel">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource OperationsCell}" />
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource OperationsColumnHeader}" />
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource OperationsRow}" />
                                <Style TargetType="TextBlock" BasedOn="{StaticResource OperationsText}" />
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="1.5*" ElementStyle="{StaticResource OperationsText}" MinWidth="180" />
                                <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource OperationsText}" MinWidth="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Expander x:Name="OperationItemDetailsExpander" Header="Dettagli dell'elemento selezionato" Margin="0,10,0,0" Style="{DynamicResource DialogExpander}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ApplicabilityReasonLabel" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"
                                           Visibility="{Binding SelectedItem.HasApplicabilityReason, ElementName=OperationItemsGrid, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}" />
                                <TextBox x:Name="OperationItemResultDetails" Text="{Binding SelectedItem.ResultDetails, ElementName=OperationItemsGrid, Mode=OneWay}" Style="{DynamicResource DialogDetails}" AutomationProperties.Name="{DynamicResource DialogItemsText}" />
                                <TextBlock Text="Dettagli tecnici" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,4" />
                                <TextBox x:Name="OperationItemDiagnostics" Text="{Binding SelectedItem.Diagnostics, ElementName=OperationItemsGrid, Mode=OneWay}" Style="{DynamicResource DialogDetails}" AutomationProperties.Name="{DynamicResource DialogDetailsText}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,14,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,12" x:Name="DialogFooter">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FooterText" Visibility="Collapsed" Margin="0,0,0,10" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" x:Name="DialogActions">
                        <Button x:Name="PauseButton" Content="{Binding PauseButtonText, Mode=OneWay}" Style="{DynamicResource DialogButton}" IsEnabled="{Binding CanPauseUpdates}" Margin="0,0,10,0" Click="Pause_Click" />
                        <Button x:Name="CloseButton" Content="Chiudi" Style="{DynamicResource DialogButton}" Visibility="Collapsed" Click="Close_Click" />
                        <Button x:Name="RestartButton" Content="Riavvia ora" Style="{DynamicResource DialogPrimaryButton}" Margin="10,0,0,0" Visibility="Collapsed" Click="Restart_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
