  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Contracts\UpdateCenter.Contracts.csproj" />
    <ProjectReference Include="..\Core\UpdateCenter.Core.csproj" />
    <ProjectReference Include="..\UpdateCenter.csproj" />
  </ItemGroup>
</Project>
