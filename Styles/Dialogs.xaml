<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="HardwareNetwork.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Explicit, dialog-local styles. Never replace the application's implicit controls. -->
    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource ManagementButton}">
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource ManagementPrimaryButton}">
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DialogCheckBox" TargetType="CheckBox" BasedOn="{StaticResource SettingsCheckBox}">
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DialogDetails" TargetType="TextBox" BasedOn="{StaticResource ManagementValue}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="MaxHeight" Value="160" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style x:Key="DialogProgress" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
    <Style x:Key="DialogExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
        <!-- Native Fluent's inner header presenter inherits the control's typography. -->
        <Setter Property="FontSize" Value="{DynamicResource FontSize13}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
