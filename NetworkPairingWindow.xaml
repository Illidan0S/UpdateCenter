<Window x:Class="UpdateCenter.NetworkPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Collega dispositivo" Width="520" SizeToContent="Height"
        MinHeight="390" MaxHeight="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Collega dispositivo" FontSize="{DynamicResource FontSize20}"
                       FontWeight="SemiBold" />
            <TextBlock Text="Autorizza questo PC a essere gestito dal Controller."
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="14" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedAgent.DisplayName, Mode=OneWay}"
                               FontWeight="SemiBold" FontSize="{DynamicResource FontSize15}" />
                    <TextBlock Text="{Binding SelectedAgent.Endpoint, Mode=OneWay}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSize10}" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="9" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="Connessione protetta" Foreground="{DynamicResource AccentBrush}"
                               FontSize="{DynamicResource FontSize10}" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Codice temporaneo" FontWeight="SemiBold" />
            <TextBlock Text="Inserisci le 8 cifre mostrate da Update Center sul dispositivo da collegare."
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSize11}"
                       TextWrapping="Wrap" Margin="0,4,0,9" />
            <TextBox x:Name="PairingCodeBox" Height="48" MaxLength="8"
                     Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold"
                     TextAlignment="Center" VerticalContentAlignment="Center"
                     PreviewKeyDown="PairingCodeBox_PreviewKeyDown" />

            <Expander Header="Opzioni avanzate" Margin="0,12,0,0"
                      Foreground="{DynamicResource MutedTextBrush}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Indirizzo IP" FontSize="{DynamicResource FontSize10}"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,4" />
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Porta" FontSize="{DynamicResource FontSize10}"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,4" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" />
                    </StackPanel>
                </Grid>
            </Expander>
        </StackPanel>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10"
                Padding="12,9" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="{DynamicResource FontSize10}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Width="110" Height="5" IsIndeterminate="True" VerticalAlignment="Center">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <Button Grid.Column="1" Content="Annulla" Style="{StaticResource SecondaryButton}"
                    Padding="16,9" Margin="0,0,8,0" IsCancel="True" />
            <Button Grid.Column="2" Content="Collega" Style="{StaticResource RoundedButton}"
                    Padding="18,9" IsEnabled="{Binding CanPair}" Click="Connect_Click" />
        </Grid>
    </Grid>
</Window>
